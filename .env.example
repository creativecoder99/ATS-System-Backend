# Server
# Note: avoid port 5000 on macOS — the AirPlay Receiver service occupies it.
PORT=4000
NODE_ENV=development

# Database — MongoDB Atlas connection string (free tier works fine)
# https://cloud.mongodb.com -> Create free cluster -> Connect -> Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hiredesk?retryWrites=true&w=majority

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS — the Vite dev server origin
CLIENT_ORIGIN=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=5
